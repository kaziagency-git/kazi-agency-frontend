# ─────────────────────────────────────────────────────────────────────────────
# Accounting module
# ─────────────────────────────────────────────────────────────────────────────
# Shared secret for the n8n integration endpoints under
# /api/accounting/integrations/*. Sent by n8n in the "x-api-key" header and
# compared with a timing-safe check. Generate one with:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Set the real value in .env.local (git-ignored) and in the Vercel project
# environment — never commit it.
ACCOUNTING_API_KEY=
